---
import SiteLayout from '../layouts/SiteLayout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { getPublishedPosts } from '../lib/posts';
import { postUrl } from '../lib/paths';
const posts = await getPublishedPosts();
const photos = posts.flatMap((post) => post.data.photos.map((photo) => ({ ...photo, postLink: postUrl(post.id), postTitle: post.data.title })));
---
<SiteLayout title="Photos" description="A collection of photographs and small details from Japan.">
  <header class="page-intro"><p class="eyebrow accent">The moments between words</p><h1>Through the lens.</h1><p>A few things to look back on. Places, details, and ordinary moments.</p></header>
  {photos.length ? <PhotoGallery photos={photos} /> : <div class="photo-empty roomy"><span class="frame-mark" aria-hidden="true">＋</span><div><h2>A collection in the making.</h2><p>The first photographs will appear here as the journey unfolds.</p></div></div>}
</SiteLayout>
