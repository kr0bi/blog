---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  photos: (CollectionEntry<'blog'>['data']['photos'][number] & { postLink?: string; postTitle?: string })[];
  priority?: boolean;
}
const { photos, priority = false } = Astro.props;
const items = await Promise.all(photos.map(async (photo) => ({
  ...photo,
  full: await getImage({ src: photo.src, width: Math.min(photo.src.width, 2400), format: 'webp' }),
})));
---
<div data-photo-gallery class:list={['photo-grid', { 'photo-grid--single': photos.length === 1 }]}>
  {items.map((photo, index) => <figure>
    <a class="photo-link" href={photo.full.src} data-pswp-width={photo.full.attributes.width} data-pswp-height={photo.full.attributes.height} data-photo-caption={photo.caption || photo.alt} data-photo-location={photo.location} aria-label={`Ingrandisci la fotografia: ${photo.alt}`}>
      <Image src={photo.src} alt={photo.alt} width={1000} layout="constrained" loading={priority && index === 0 ? 'eager' : 'lazy'} fetchpriority={priority && index === 0 ? 'high' : undefined} />
    </a>
    <figcaption>
      {photo.location && <span class="eyebrow">{photo.location}</span>}
      {photo.caption && <p>{photo.caption}</p>}
      {photo.postLink && <a href={photo.postLink}>{photo.postTitle} <span aria-hidden="true">↗</span></a>}
    </figcaption>
  </figure>)}
</div>

<script>
  import '../scripts/photo-lightbox';
</script>
